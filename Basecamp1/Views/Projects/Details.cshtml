@model Basecamp1.Models.Project

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Name</h1>
        <p class="text-secondary">@Model.Description</p>
    </div>
</div>

<div class="dashboard-card">

    <h3 class="mb-4">Tasks</h3>

    <!-- ADD TASK -->
    <form method="post" action="/Tasks/Create" class="d-flex gap-2 mb-4">

        <input type="hidden" name="ProjectId" value="@Model.Id" />

        <input type="text"
               name="Title"
               class="form-control"
               placeholder="Add new task..."
               required />

        <button class="btn btn-primary">
            Add
        </button>

    </form>

    <!-- TASK LIST -->
    @foreach (var task in Model.Tasks)
    {
        <div class="project-item">

            <div class="d-flex align-items-center gap-3">

                @if (task.IsCompleted)
                {
                    <span>✅</span>
                }
                else
                {
                    <span>🕒</span>
                }

                <strong>@task.Title</strong>

            </div>

            <div class="d-flex gap-2">

                @if (!task.IsCompleted)
                {
                    <a class="btn btn-success btn-sm"
                           href="/Tasks/Complete/@task.Id">
                        Complete
                    </a>
                }

                <a class="btn btn-danger btn-sm"
                       href="/Tasks/Delete/@task.Id">
                    Delete
                </a>

            </div>

        </div>
    }

</div>