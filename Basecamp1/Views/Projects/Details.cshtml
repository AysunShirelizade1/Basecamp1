@model Basecamp1.Models.Project
@using Microsoft.AspNetCore.Http
@{
    var currentUserId = Context.Session.GetInt32("UserId") ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@Model.Name</h1>
        <p class="text-secondary">@Model.Description</p>
    </div>
</div>

<!-- TASKS -->
<div class="dashboard-card mb-4">
    <h3 class="mb-4">Tasks</h3>

    <form method="post" action="/Tasks/Create" class="d-flex gap-2 mb-4">
        <input type="hidden" name="ProjectId" value="@Model.Id" />
        <input type="text" name="Title" class="form-control"
               placeholder="Add new task..." required />
        <button type="submit" class="btn btn-primary">Add</button>
    </form>

    @foreach (var task in Model.Tasks)
    {
        <div class="project-item">
            <div class="d-flex align-items-center gap-3">
                @if (task.IsCompleted)
                {
                    <span>✅</span>
                }
                else
                {
                    <span>🕒</span>
                }
                <strong>@task.Title</strong>
            </div>
            <div class="d-flex gap-2">
                @if (!task.IsCompleted)
                {
                    <a class="btn btn-success btn-sm" href="/Tasks/Complete/@task.Id">Complete</a>
                }
                <a class="btn btn-danger btn-sm" href="/Tasks/Delete/@task.Id">Delete</a>
            </div>
        </div>
    }
</div>

<!-- ATTACHMENTS -->
<div class="dashboard-card mb-4">
    <h3 class="mb-4">Attachments</h3>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <form action="/Attachments/Create" method="post"
          enctype="multipart/form-data" class="d-flex gap-2 mb-4">
        <input type="hidden" name="projectId" value="@Model.Id" />
        <input type="file" name="file" class="form-control"
               accept=".png,.jpg,.jpeg,.pdf,.txt" required />
        <button type="submit" class="btn btn-primary">Upload</button>
    </form>

    @if (Model.Attachments != null && Model.Attachments.Any())
    {
        @foreach (var att in Model.Attachments)
        {
            <div class="project-item">
                <div class="d-flex align-items-center gap-3">
                    <span>📎</span>
                    <span class="badge bg-secondary">@att.Format.ToUpper()</span>
                    <span>@att.FileName</span>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Attachments/Download/@att.Id"
                       class="btn btn-sm btn-outline-info">⬇ Download</a>
                    @if (att.UserId == currentUserId)
                    {
                        <form action="/Attachments/Delete/@att.Id" method="post"
                              style="display:inline;">
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-secondary">No attachments yet.</p>
    }
</div>
<!-- MEMBERS -->
<div class="dashboard-card mb-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Members</h3>
    </div>

    @if (currentUserId == Model.AdminId)
    {
        <form action="/ProjectMembers/Add" method="post" class="d-flex gap-2 mb-4">
            <input type="hidden" name="projectId" value="@Model.Id" />
            <select name="userId" class="form-select">
                @foreach (var user in ViewBag.AllUsers as List<Basecamp1.Models.User>)
                {
                    <option value="@user.Id">@user.FullName (@user.Email)</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Add Member</button>
        </form>
    }

    @if (Model.Members != null && Model.Members.Any())
    {
        @foreach (var member in Model.Members)
        {
            <div class="project-item">
                <div class="d-flex align-items-center gap-3">
                    <span>👤</span>
                    <strong>@member.User?.FullName</strong>
                    <span class="text-secondary">@member.User?.Email</span>
                </div>
                @if (currentUserId == Model.AdminId)
                {
                    <form action="/ProjectMembers/Remove" method="post"
                          style="display:inline;">
                        <input type="hidden" name="projectId" value="@Model.Id" />
                        <input type="hidden" name="userId" value="@member.UserId" />
                        <button class="btn btn-danger btn-sm">Remove</button>
                    </form>
                }
            </div>
        }
    }
    else
    {
        <p class="text-secondary">No members yet.</p>
    }
</div>
<!-- DISCUSSION THREADS -->
<div class="dashboard-card">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>Discussion Threads</h3>
        @if (currentUserId == Model.AdminId)
        {
            <a href="/Threads/Create?projectId=@Model.Id" class="btn btn-primary">
                + New Thread
            </a>
        }
    </div>

    @if (Model.Threads != null && Model.Threads.Any())
    {
        @foreach (var thread in Model.Threads)
        {
            <div class="project-item">
                <div class="d-flex align-items-center gap-3">
                    <span>💬</span>
                    <strong>@thread.Title</strong>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Threads/Show/@thread.Id"
                       class="btn btn-dark btn-sm">Open</a>
                    @if (thread.UserId == currentUserId)
                    {
                        <a href="/Threads/Edit/@thread.Id"
                           class="btn btn-warning btn-sm">Edit</a>
                        <form action="/Threads/Delete/@thread.Id" method="post"
                              style="display:inline;">
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <p class="text-secondary">No discussion threads yet.</p>
    }
</div>