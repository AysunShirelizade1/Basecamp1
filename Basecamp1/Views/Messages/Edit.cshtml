@model Basecamp1.Models.Message

<div class="dashboard-card">
    <h2 class="mb-4">Edit Message</h2>

    <form method="post" action="/Messages/Edit">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="ThreadId" value="@Model.ThreadId" />

        <div class="mb-3">
            <label class="form-label">Message</label>
            <textarea name="Content" class="form-control"
                      rows="4" required>@Model.Content</textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/Threads/Show/@Model.ThreadId"
               class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>  