@model Basecamp1.Models.ForumThread
@using Microsoft.AspNetCore.Http
@{
    var currentUserId = Context.Session.GetInt32("UserId") ?? 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>💬 @Model.Title</h1>
        <p class="text-secondary">
            Project: <a href="/Projects/Details/@Model.ProjectId">@Model.Project?.Name</a>
        </p>
    </div>
    <a href="/Projects/Details/@Model.ProjectId" class="btn btn-secondary">← Back</a>
</div>

<!-- MESSAGES -->
<div class="dashboard-card mb-4">
    @if (Model.Messages != null && Model.Messages.Any())
    {
        @foreach (var msg in Model.Messages.OrderBy(m => m.CreatedAt))
        {
            <div class="project-item mb-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <strong>@msg.User?.FullName</strong>
                        <span class="text-secondary" style="font-size:0.85rem;">
                            @msg.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                    <p class="mb-0">@msg.Content</p>
                </div>
                @if (msg.UserId == currentUserId)
                {
                    <div class="d-flex gap-2">
                        <a href="/Messages/Edit/@msg.Id"
                           class="btn btn-warning btn-sm">Edit</a>
                        <form action="/Messages/Delete/@msg.Id" method="post"
                              style="display:inline;">
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <p class="text-secondary">No messages yet. Be the first to write!</p>
    }
</div>

<!-- NEW MESSAGE -->
<div class="dashboard-card">
    <h5 class="mb-3">Write a Message</h5>
    <form method="post" action="/Messages/Create">
        <input type="hidden" name="ThreadId" value="@Model.Id" />
        <div class="mb-3">
            <textarea name="Content" class="form-control" rows="3"
                      placeholder="Write your message..." required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Send</button>
    </form>
</div>