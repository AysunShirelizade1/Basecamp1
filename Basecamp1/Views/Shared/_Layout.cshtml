<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Basecamp1</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow px-4">

            <!-- LOGO -->
            <a class="navbar-brand fw-bold text-white"
                   asp-controller="Projects"
                   asp-action="Index">
                 Basecamp
            </a>

            <!-- LEFT MENU -->
            <div class="navbar-nav me-auto ms-4">

                <a class="nav-link text-white"
                       asp-controller="Projects"
                       asp-action="Index">
                      Projects
                </a>

                @if (Context.Session.GetString("IsAdmin") == "true")
                {
                    <a class="nav-link text-warning fw-bold"
                           asp-controller="Admin"
                           asp-action="Users">
                           Users / Admin
                    </a>
                }

            </div>

            <!-- RIGHT MENU -->
            <div class="ms-auto d-flex align-items-center">

                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <span class="text-white me-3">
                        @Context.Session.GetString("UserName")
                            
                        @if (Context.Session.GetString("IsAdmin") == "true")
                        {
                            <span class="badge bg-warning text-dark ms-1">Admin</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary ms-1">User</span>
                        }
                    </span>

                    @if (Context.Session.GetString("IsAdmin") == "true")
                    {
                        <a class="btn btn-warning btn-sm me-2" href="/Admin/Users">
                            Admin Panel
                        </a>
                    }

                    <a class="btn btn-outline-light btn-sm" href="/Account/Logout">
                        Logout
                    </a>
                }

            </div>

        </nav>
    </header>

    <!-- PAGE CONTENT -->
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="border-top footer text-muted mt-5">
        <div class="container py-3">
            © 2026 - Basecamp1
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>