<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Basecamp1</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="brand">Basecamp</div>

            @if (Context.Session.GetInt32("UserId") != null)
            {
                <nav class="sidebar-menu">
                    <a href="/Dashboard/Index">🏠 Dashboard</a>
                    <a href="/Projects/Index">📁 Projects</a>
                    <a href="/Profile/Index">👤 Profile</a>

                    @if (Context.Session.GetString("IsAdmin") == "true")
                    {
                        <a href="/Admin/Users">👥 Users / Admin</a>
                    }
                </nav>
            }

            <div class="sidebar-footer">

                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <div class="user-card">
                        <div class="user-avatar">
                            @Context.Session.GetString("UserName")?.Substring(0, 1)
                        </div>

                        <div>
                            <strong>@Context.Session.GetString("UserName")</strong>
                            <span>
                                @(Context.Session.GetString("IsAdmin") == "true" ? "Admin" : "User")
                            </span>
                        </div>
                    </div>

                    <a class="logout-btn" href="/Account/Logout">Logout</a>
                }
                else
                {
                    <a class="logout-btn" href="/Account/Login">Login</a>
                }

            </div>
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>