<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Basecamp1</title>
    <script type="importmap"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Basecamp1.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow px-4">
            <a class="navbar-brand fw-bold text-white" href="/Projects">
                 Basecamp
            </a>

            <div class="ms-auto d-flex align-items-center">
                @if (Context.Session.GetInt32("UserId") != null)
                {
                    <span class="text-white me-3">
                         @Context.Session.GetString("UserName")
                    </span>

                    @if (Context.Session.GetString("IsAdmin") == "true")
                    {
                        <a class="btn btn-warning btn-sm me-2" href="/Admin/Users">Admin</a>
                    }

                    <a class="btn btn-outline-light btn-sm" href="/Account/Logout">Logout</a>
                }
            </div>
        </nav>
    </header>
    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container mt-4">
            &copy; 2026 - Basecamp1 - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
