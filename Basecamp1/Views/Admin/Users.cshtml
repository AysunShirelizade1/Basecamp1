@model List<Basecamp1.Models.User>

<div class="admin-header">
    <div>
        <h1>Users Management</h1>
        <p>Manage users, permissions and admin roles.</p>
    </div>
</div>

<div class="admin-card">
    <table class="admin-table">
        <thead>
            <tr>
                <th>User</th>
                <th>Email</th>
                <th>Role</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>
                        <div class="admin-user">
                            <div class="admin-avatar">
                                @user.FullName.Substring(0, 1)
                            </div>
                            <strong>@user.FullName</strong>
                        </div>
                    </td>

                    <td>@user.Email</td>

                    <td>
                        @if (user.IsAdmin)
                        {
                            <span class="role-badge admin-role">Admin</span>
                        }
                        else
                        {
                            <span class="role-badge user-role">User</span>
                        }
                    </td>

                    <td class="text-end">
                        @if (!user.IsAdmin)
                        {
                            <a class="btn-action make-admin" href="/Admin/SetAdmin/@user.Id">
                                Make Admin
                            </a>
                        }
                        else
                        {
                            <a class="btn-action remove-admin" href="/Admin/RemoveAdmin/@user.Id">
                                Remove Admin
                            </a>
                        }

                        <a class="btn-action delete-user" href="/Admin/Delete/@user.Id">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>