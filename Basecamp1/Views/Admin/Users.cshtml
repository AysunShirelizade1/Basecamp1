@model List<Basecamp1.Models.User>

<h2 class="text-white mb-4">Users Management</h2>

<table class="table table-dark table-hover table-bordered">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.FullName</td>
                <td>@user.Email</td>
                <td>
                    @if (user.IsAdmin)
                    {
                        <span class="badge bg-warning text-dark">Admin</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">User</span>
                    }
                </td>
                <td>
                    @if (!user.IsAdmin)
                    {
                        <a class="btn btn-warning btn-sm" href="/Admin/SetAdmin/@user.Id">
                            Make Admin
                        </a>
                    }
                    else
                    {
                        <a class="btn btn-secondary btn-sm" href="/Admin/RemoveAdmin/@user.Id">
                            Remove Admin
                        </a>
                    }

                    <a class="btn btn-danger btn-sm" href="/Admin/Delete/@user.Id">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>