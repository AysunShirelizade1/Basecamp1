<h2>Users</h2>

<a href="/Projects">Back to Projects</a>

<table border="1">
    <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Admin</th>
        <th>Actions</th>
    </tr>

    @foreach (var user in Model)
    {
        <tr>
            <td>@user.FullName</td>
            <td>@user.Email</td>
            <td>@user.IsAdmin</td>
            <td>
                <a href="/Admin/Delete/@user.Id">Delete</a>

                @if (!user.IsAdmin)
                {
                    <a href="/Admin/SetAdmin/@user.Id">Make Admin</a>
                }
                else
                {
                    <a href="/Admin/RemoveAdmin/@user.Id">Remove Admin</a>
                }
            </td>
        </tr>
    }
</table>